# homelab-panel settings
#
# This file becomes /etc/homelab-panel/.env inside the panel's container. The installer copies
# it there and fills in the blanks (the API token, the container's own ID). You only need to
# edit it by hand if you want to change a setting later. After editing, restart the panel:
#
#   systemctl restart homelab-panel
#
# The file holds the secret half of the panel's Proxmox API token, so only root can change it
# and only the panel's own user can read it (owner root, group homelab-panel, mode 0640).
#
# The format is plain KEY=value lines, read by systemd. Don't add quotes, `export`, or `~`.

# --- Where the panel listens ----------------------------------------------------------------

# 0.0.0.0 means "every network address this container has", so you can reach the panel from
# other machines on your network (and over Tailscale, if you chose it). The panel refuses to
# start like this unless a sign-in password is set, so it can never be open to your whole
# network by accident. The installer sets the password for you.
PANEL_BIND=0.0.0.0

# The port the web page is on: http://<container-address>:8420
PANEL_PORT=8420

# Fake-data mode, for trying the panel without a cluster. Always 0 on a real install.
PANEL_MOCK=0

# --- Where the panel keeps its files --------------------------------------------------------

# The panel's database (job history, sign-in sessions), the logs of past jobs, and the
# password hash live here.
PANEL_DATA_DIR=/var/lib/homelab-panel

# Which Proxmox nodes the panel connects to, and how. The installer writes this file from your
# cluster's own list of nodes.
PANEL_HOSTS_FILE=/etc/homelab-panel/hosts.yaml

# The ID of the container the panel itself runs in. The installer fills this in. The panel uses
# it to look after itself: when you upgrade several things at once it does its own container
# and node last, and it warns you before restarting either one, because the page goes offline
# for a minute while it does.
PANEL_SELF_CTID=

# --- How the panel talks to Proxmox ---------------------------------------------------------

# Which node's API to try first. Blank means the first node in hosts.yaml. If that node is
# down, the panel tries the others.
PVE_API_HOST=

# The API token the installer created: a Proxmox user called panel@pve with a role
# (PanelRole) that allows only what the panel needs. The secret is filled in by the installer.
PVE_TOKEN_ID=panel@pve!panel
PVE_TOKEN_SECRET=

# Proxmox nodes use self-signed HTTPS certificates out of the box, so certificate checking is
# off. Set this to true if your nodes have certificates from a real authority.
PVE_VERIFY_TLS=false

# --- How the panel logs in to the nodes over SSH --------------------------------------------

# The panel's own SSH key, made inside this container by the installer. It never leaves the
# container. Upgrades and file transfers run over SSH with it.
SSH_KEY_PATH=/etc/homelab-panel/ssh/id_ed25519

# --- Logging --------------------------------------------------------------------------------

# How much the panel writes to its log (journalctl -u homelab-panel). "debug" shows more.
RUST_LOG=info
